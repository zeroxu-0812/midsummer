# ============================================================================
# Walmart 飞书爬虫 —— 环境变量样例
# 复制为 .env 并填入真实值（.env 不要提交到仓库）
# ============================================================================

# ---- 飞书应用凭据 ----
# 建议为 Walmart 单独建一个飞书应用（独立 app_id/secret），避免事件争抢。
# 优先读 WALMART_FEISHU_*，缺省回退到共享的 FEISHU_*。
WALMART_FEISHU_APP_ID=
WALMART_FEISHU_APP_SECRET=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ---- 输出电子表格 ----
# 飞书电子表格的 wiki 链接，如 https://xxx.feishu.cn/wiki/xxxxxxxx
# 留空则每次新建电子表格（建在应用根目录或下面的 folder）。
WALMART_SPREADSHEET_WIKI_URL=
# 可选：表格 token（不填则用上面的 URL 自动解析）
WALMART_SPREADSHEET_TOKEN=
# 可选：新建电子表格时存放的文件夹 token（从飞书文件夹 URL 末段取）
WALMART_REPORT_FOLDER_TOKEN=

# ---- 爬取默认参数 ----
WALMART_DEFAULT_PAGES=2
WALMART_MAX_PAGES=5
WALMART_DEFAULT_SORT=best_match
